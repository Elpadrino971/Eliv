<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Textes d'autorisation. Apple exige qu'ils disent PRECISEMENT a quoi sert
	     l'acces : les formulations generiques ("this app needs microphone
	     access") sont un motif classique de rejet. Bilingues FR/EN, le public
	     principal etant francophone et le relecteur anglophone. -->

	<key>NSMicrophoneUsageDescription</key>
	<string>VybzzZ utilise le micro pour diffuser ta voix quand tu es en live et pour parler dans le chat audio. — VybzzZ uses the microphone to broadcast your voice during a live show and to speak in audio chat.</string>

	<key>NSCameraUsageDescription</key>
	<string>VybzzZ utilise la camera pour te filmer pendant un live et pour prendre ta photo de profil. — VybzzZ uses the camera to film you during a live show and to take your profile picture.</string>

	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>VybzzZ utilise le Bluetooth pour envoyer le son de tes lives vers tes ecouteurs ou ton enceinte. — VybzzZ uses Bluetooth to route live audio to your headphones or speaker.</string>

	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>VybzzZ utilise le Bluetooth pour envoyer le son de tes lives vers tes ecouteurs ou ton enceinte. — VybzzZ uses Bluetooth to route live audio to your headphones or speaker.</string>

	<key>NSLocalNetworkUsageDescription</key>
	<string>VybzzZ utilise le reseau local pour garder ton live fluide quand tu diffuses en Wi-Fi. — VybzzZ uses the local network to keep your live stream smooth over Wi-Fi.</string>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>VybzzZ ouvre ta photothèque pour que tu choisisses ta photo de profil, la couverture d'un concert ou un extrait a publier. — VybzzZ opens your photo library so you can pick your profile picture, a concert cover or a clip to publish.</string>

	<key>UIBackgroundModes</key>
	<array>
    <string>audio</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(APP_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>artist</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>FlutterSceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Autorise le HTTP vers le backend local (dev). Le reste du trafic reste en HTTPS. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- URL scheme requis par Google Sign-In pour rediriger vers l'app après
	     connexion (REVERSED_CLIENT_ID de GoogleService-Info.plist). Il doit
	     correspondre EXACTEMENT au client OAuth iOS declare dans Firebase :
	     sinon le choix du compte Google s'ouvre, mais ne revient jamais dans
	     l'application.

	     Le client a change cote Firebase (…gkcfj2vg… -> …c5us844q…). L'ancien
	     schema est conserve le temps de valider un build avec le nouveau :
	     enregistrer deux schemas est sans effet de bord, et cela evite de
	     casser la connexion si l'ancien client est encore en service. A
	     retirer une fois la connexion Google verifiee sur un appareil iOS. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.284585255358-c5us844q11m010pa2l4suppl6j5qbevt</string>
				<string>com.googleusercontent.apps.284585255358-gkcfj2vg7cte3dql3r8i7b1rdkrkghu9</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
