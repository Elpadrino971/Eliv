# Copie ce fichier en .env et remplis les valeurs (NE PAS committer .env).

# Secret de signature des tokens (mets une longue chaîne aléatoire en prod)
JWT_SECRET=change-me-with-a-long-random-string

# Port (en local 8002 ; en prod, l'hébergeur fournit $PORT automatiquement)
PORT=8002

# Chemin de la base SQLite. En prod, pour PERSISTER les données, monte un volume
# (ex. /data) et mets : VYBZZZ_DB=/data/vybzzz.sqlite
# Sinon, la base est recréée + re-seedée à chaque redéploiement.
# VYBZZZ_DB=/data/vybzzz.sqlite

# URL publique du backend (sert à construire les liens de fichiers uploadés)
PUBLIC_BASE_URL=https://api.vybzzz.online

# ── Mux (stockage/streaming replays concerts + clips) ──
# Dashboard Mux -> Settings -> API Access Tokens (droits "Full Access" video).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Dashboard Mux -> Settings -> Webhooks -> Signing secret (vérifie les callbacks).
MUX_WEBHOOK_SECRET=
# Fenêtre de rétention avant suppression auto de l'asset Mux (cron quotidien).
# 60j pour les replays concert (contrainte Apple : ventes possibles pendant 60j).
REPLAY_RETENTION_DAYS=60
# 30j pour les clips du feed (léger, on augmente progressivement si besoin).
CLIP_RETENTION_DAYS=30

# ── À brancher plus tard (prod réelle) ──
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
