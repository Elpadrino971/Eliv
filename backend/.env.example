# Copie ce fichier en .env et remplis les valeurs (NE PAS committer .env).

# Secret de signature des tokens (mets une longue chaîne aléatoire en prod)
JWT_SECRET=change-me-with-a-long-random-string

# Port (en local 8002 ; en prod, l'hébergeur fournit $PORT automatiquement)
PORT=8002

# Chemin de la base SQLite. En prod, pour PERSISTER les données, monte un volume
# (ex. /data) et mets : VYBZZZ_DB=/data/vybzzz.sqlite
# Sinon, la base est recréée + re-seedée à chaque redéploiement.
# VYBZZZ_DB=/data/vybzzz.sqlite

# URL publique du backend (sert à construire les liens de fichiers uploadés)
PUBLIC_BASE_URL=https://api.vybzzz.online

# ── Mux (stockage/streaming replays concerts + clips) ──
# Dashboard Mux -> Settings -> API Access Tokens (droits "Full Access" video).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Dashboard Mux -> Settings -> Webhooks -> Signing secret (vérifie les callbacks).
MUX_WEBHOOK_SECRET=
# Fenêtre de rétention avant suppression auto de l'asset Mux (cron quotidien).
# 60j pour les replays concert (contrainte Apple : ventes possibles pendant 60j).
REPLAY_RETENTION_DAYS=60
# 30j pour les clips du feed (léger, on augmente progressivement si besoin).
CLIP_RETENTION_DAYS=30

# ── Stripe (paiement carte, abonnements artiste) ──
# Dashboard Stripe -> Développeurs -> Clés API -> Clé secrète (sk_live_...).
STRIPE_SECRET_KEY=
# Dashboard Stripe -> Développeurs -> Webhooks -> endpoint -> Signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=

# ── RevenueCat (IAP App Store / Play Store) ──
# Dashboard RevenueCat -> Project VyBzzZ -> Integrations -> Webhooks -> + New.
# URL : https://api.vybzzz.online/api/revenuecat/webhook
# Authorization header (Bearer) : colle EXACTEMENT la même valeur ici et dans
# le champ "Authorization header value" du webhook RevenueCat.
REVENUECAT_WEBHOOK_AUTH=

# ── ZegoCloud (live streaming) ──
# Console Zego -> Projet -> AppID (déjà en dur côté app, pas un secret).
# Projet "VyBzzZ" sur le compte du client (l'ancien 1112572789 appartenait au dev).
ZEGO_APP_ID=266313543
# Console Zego -> Projet -> ServerSecret (32 caractères) — ATTENTION, DIFFÉRENT
# de l'AppSign ! Sert UNIQUEMENT à générer des tokens côté serveur, ne jamais
# mettre ça dans l'app.
ZEGO_SERVER_SECRET=

# ── Anthropic (Claude) : rédaction assistée des descriptions/bios dans l'admin ──
# console.anthropic.com -> API Keys -> Create Key.
ANTHROPIC_API_KEY=

# ── Resend (envoi d'email : code OTP inscription / mot de passe oublié) ──
# Tant que RESEND_API_KEY est vide, l'app retombe sur l'ancien code démo fixe
# "1234" (aucun email envoyé) -> rien ne casse pendant que le domaine
# d'envoi est en cours de vérification.
# resend.com -> API Keys -> Create API Key.
RESEND_API_KEY=
# Nécessite un domaine VÉRIFIÉ dans Resend (Domains -> Add Domain -> DNS chez
# le registrar). Tant que ce n'est pas fait, Resend n'autorise l'envoi qu'à
# l'adresse email du compte Resend lui-même, pas aux vrais utilisateurs.
EMAIL_FROM=VYBZZZ <no-reply@vybzzz.online>

# ── Firebase Storage (clips légers du feed, alternative à Mux) ──
# Nom du bucket (déjà dans lib/firebase_options.dart, projet "vybzzz-app" —
# ton propre compte Google, pas celui du dev).
FIREBASE_STORAGE_BUCKET=vybzzz-app.firebasestorage.app
# Firebase Console -> Paramètres du projet -> Comptes de service -> Générer
# une nouvelle clé privée -> télécharge le JSON, puis encode-le en base64 :
#   base64 -i chemin/vers/service-account.json | tr -d '\n'
# et colle le résultat (une seule ligne) ici.
FIREBASE_SERVICE_ACCOUNT_BASE64=
