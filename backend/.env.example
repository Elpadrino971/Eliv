# Copie ce fichier en .env et remplis les valeurs (NE PAS committer .env).

# Secret de signature des tokens (mets une longue chaîne aléatoire en prod)
JWT_SECRET=change-me-with-a-long-random-string

# Port (en local 8002 ; en prod, l'hébergeur fournit $PORT automatiquement)
PORT=8002

# Chemin de la base SQLite. En prod, pour PERSISTER les données, monte un volume
# (ex. /data) et mets : VYBZZZ_DB=/data/vybzzz.sqlite
# Sinon, la base est recréée + re-seedée à chaque redéploiement.
# VYBZZZ_DB=/data/vybzzz.sqlite

# ── À brancher plus tard (prod réelle) ──
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
