<?xml version="1.0" encoding="utf-8"?>
<!--
  L'application declarait android:usesCleartextTraffic="true" : tout le trafic
  pouvait passer en HTTP non chiffre, y compris les identifiants et les jetons.
  Sur un Wi-Fi hostile, cela ouvre la porte a l'interception.

  Le trafic sortant est desormais chiffre par defaut. Seules les adresses de
  developpement local restent autorisees en clair, pour pouvoir continuer a
  pointer l'application sur un backend lance sur le Mac.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
